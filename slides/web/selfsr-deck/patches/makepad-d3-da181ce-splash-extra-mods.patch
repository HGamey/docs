+/// 宿主应用可在这里登记额外的脚本模块（例如自定义 widget），d3.Splash 创建沙箱 VM 时依次注册。
+pub static SPLASH_EXTRA_MODS: std::sync::Mutex<Vec<fn(&mut ScriptVm)>> = std::sync::Mutex::new(Vec::new());
+
+/// 登记一个在每个 d3.Splash 沙箱 VM 里执行的脚本模块注册函数。
+pub fn register_splash_mod(f: fn(&mut ScriptVm)) {
+    if let Ok(mut g) = SPLASH_EXTRA_MODS.lock() {
+        if !g.iter().any(|x| *x as usize == f as usize) {
+            g.push(f);
+        }
+    }
+}
