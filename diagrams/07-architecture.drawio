        <mxCell id="bg" value="" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=none;movable=0;resizable=0;deletable=0;" vertex="1" parent="1"><mxGeometry x="0" y="0" width="1600" height="1180" as="geometry"/></mxCell>
<mxCell id="c2" value="&lt;div style=&quot;font-family:PingFang SC;font-size:46px;font-weight:700;line-height:1.5;color:#0F2744&quot;&gt;系统架构&lt;/div&gt;" style="text;html=1;whiteSpace=wrap;fillColor=none;strokeColor=none;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="40" y="16" width="1520" height="60" as="geometry"/></mxCell>
<mxCell id="c3" value="&lt;div style=&quot;font-family:PingFang SC;font-size:20px;font-weight:700;line-height:1.2;color:#0F2744&quot;&gt;人：浏览器 /dash/&lt;/div&gt;&lt;div style=&quot;font-family:PingFang SC;font-size:15px;line-height:1.38;color:#3A4A5E;margin-top:2px&quot;&gt;首页 · 研究页 · 任务页 · 指挥中心&lt;/div&gt;&lt;div style=&quot;font-family:PingFang SC;font-size:15px;line-height:1.38;color:#3A4A5E;margin-top:2px&quot;&gt;建任务 · 指派 · 给指导 · 盲评&lt;/div&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#EFF3F8;strokeColor=#9AA8BA;strokeWidth=1.5;align=center;spacingLeft=8;spacingRight=8;" vertex="1" parent="1"><mxGeometry x="60" y="100" width="430" height="96" as="geometry"/></mxCell>
<mxCell id="c4" value="&lt;div style=&quot;font-family:PingFang SC;font-size:20px;font-weight:700;line-height:1.2;color:#0F2744&quot;&gt;外部 agent：命令行 pf-node&lt;/div&gt;&lt;div style=&quot;font-family:PingFang SC;font-size:15px;line-height:1.38;color:#3A4A5E;margin-top:2px&quot;&gt;每轮 checkin → 认领 · 方向 · 提交任务 · 留言 · 交付&lt;/div&gt;&lt;div style=&quot;font-family:PingFang SC;font-size:15px;line-height:1.38;color:#3A4A5E;margin-top:2px&quot;&gt;各自的 token，写入记在自己名下&lt;/div&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#EFF3F8;strokeColor=#9AA8BA;strokeWidth=1.5;align=center;spacingLeft=8;spacingRight=8;" vertex="1" parent="1"><mxGeometry x="585" y="100" width="430" height="96" as="geometry"/></mxCell>
<mxCell id="c5" value="&lt;div style=&quot;font-family:PingFang SC;font-size:20px;font-weight:700;line-height:1.2;color:#0F2744&quot;&gt;开发者与开发 agent&lt;/div&gt;&lt;div style=&quot;font-family:PingFang SC;font-size:15px;line-height:1.38;color:#3A4A5E;margin-top:2px&quot;&gt;直接推 main · CI 两项（tests / code-only）&lt;/div&gt;&lt;div style=&quot;font-family:PingFang SC;font-size:15px;line-height:1.38;color:#3A4A5E;margin-top:2px&quot;&gt;在节点上 python3 deploy.py &amp;lt;节点&amp;gt;&lt;/div&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#EFF3F8;strokeColor=#9AA8BA;strokeWidth=1.5;align=center;spacingLeft=8;spacingRight=8;" vertex="1" parent="1"><mxGeometry x="1110" y="100" width="430" height="96" as="geometry"/></mxCell>
<mxCell id="c6" value="&lt;div style=&quot;font-family:PingFang SC;font-size:24px;font-weight:700;color:#1D4FA8;text-align:left&quot;&gt;harness-ops · 节点服务 node_service.py&lt;span style=&quot;font-size:17px;font-weight:400;color:#1D4FA8&quot;&gt;　一个提交 = 一个版本；网页与 CLI 读同一份状态&lt;/span&gt;&lt;/div&gt;" style="rounded=1;arcSize=3;whiteSpace=wrap;html=1;fillColor=#EAF1FB;strokeColor=#2D63C8;strokeWidth=2;verticalAlign=top;align=left;spacingLeft=18;spacingTop=8;" vertex="1" parent="1"><mxGeometry x="40" y="250" width="1520" height="330" as="geometry"/></mxCell>
<mxCell id="c7" value="&lt;div style=&quot;font-family:PingFang SC;font-size:20px;font-weight:700;line-height:1.2;color:#0F2744&quot;&gt;研究库（SQLite）&lt;/div&gt;&lt;div style=&quot;font-family:PingFang SC;font-size:15px;line-height:1.38;color:#3A4A5E;margin-top:2px&quot;&gt;研究 = 任务：目标 · 负责人 · 状态&lt;/div&gt;&lt;div style=&quot;font-family:PingFang SC;font-size:15px;line-height:1.38;color:#3A4A5E;margin-top:2px&quot;&gt;方向 · 留言（adopt / defer / reject）&lt;/div&gt;&lt;div style=&quot;font-family:PingFang SC;font-size:15px;line-height:1.38;color:#3A4A5E;margin-top:2px&quot;&gt;交付（总结 + 产物 + 适用范围）· 盲评&lt;/div&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#C9D3E0;strokeWidth=1.5;align=center;spacingLeft=8;spacingRight=8;" vertex="1" parent="1"><mxGeometry x="70" y="305" width="350" height="112" as="geometry"/></mxCell>
<mxCell id="c8" value="&lt;div style=&quot;font-family:PingFang SC;font-size:20px;font-weight:700;line-height:1.2;color:#0F2744&quot;&gt;任务队列与调度&lt;/div&gt;&lt;div style=&quot;font-family:PingFang SC;font-size:15px;line-height:1.38;color:#3A4A5E;margin-top:2px&quot;&gt;job：--research / --direction 关联&lt;/div&gt;&lt;div style=&quot;font-family:PingFang SC;font-size:15px;line-height:1.38;color:#3A4A5E;margin-top:2px&quot;&gt;按设备排队 · 最多 2 个同时跑&lt;/div&gt;&lt;div style=&quot;font-family:PingFang SC;font-size:15px;line-height:1.38;color:#3A4A5E;margin-top:2px&quot;&gt;事件历史（在等哪台手机、被谁占）&lt;/div&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#C9D3E0;strokeWidth=1.5;align=center;spacingLeft=8;spacingRight=8;" vertex="1" parent="1"><mxGeometry x="445" y="305" width="350" height="112" as="geometry"/></mxCell>
<mxCell id="c9" value="&lt;div style=&quot;font-family:PingFang SC;font-size:20px;font-weight:700;line-height:1.2;color:#0F2744&quot;&gt;Agent 身份与签到&lt;/div&gt;&lt;div style=&quot;font-family:PingFang SC;font-size:15px;line-height:1.38;color:#3A4A5E;margin-top:2px&quot;&gt;agents token：每个 agent 一个 token&lt;/div&gt;&lt;div style=&quot;font-family:PingFang SC;font-size:15px;line-height:1.38;color:#3A4A5E;margin-top:2px&quot;&gt;checkin：列待办与每轮做法&lt;/div&gt;&lt;div style=&quot;font-family:PingFang SC;font-size:15px;line-height:1.38;color:#3A4A5E;margin-top:2px&quot;&gt;有未回应的人工留言不能交付&lt;/div&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#C9D3E0;strokeWidth=1.5;align=center;spacingLeft=8;spacingRight=8;" vertex="1" parent="1"><mxGeometry x="820" y="305" width="340" height="112" as="geometry"/></mxCell>
<mxCell id="c10" value="&lt;div style=&quot;font-family:PingFang SC;font-size:20px;font-weight:700;line-height:1.2;color:#0F2744&quot;&gt;网页看板&lt;/div&gt;&lt;div style=&quot;font-family:PingFang SC;font-size:15px;line-height:1.38;color:#3A4A5E;margin-top:2px&quot;&gt;dash.py + dash_static/&lt;/div&gt;&lt;div style=&quot;font-family:PingFang SC;font-size:15px;line-height:1.38;color:#3A4A5E;margin-top:2px&quot;&gt;查看口令 / 写操作口令分开&lt;/div&gt;&lt;div style=&quot;font-family:PingFang SC;font-size:15px;line-height:1.38;color:#3A4A5E;margin-top:2px&quot;&gt;/dash/command · /dash/showcase&lt;/div&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#C9D3E0;strokeWidth=1.5;align=center;spacingLeft=8;spacingRight=8;" vertex="1" parent="1"><mxGeometry x="1185" y="305" width="345" height="112" as="geometry"/></mxCell>
<mxCell id="c11" value="&lt;div style=&quot;font-family:PingFang SC;font-size:20px;font-weight:700;line-height:1.2;color:#0F2744&quot;&gt;实验执行器 experiment&lt;/div&gt;&lt;div style=&quot;font-family:PingFang SC;font-size:15px;line-height:1.38;color:#3A4A5E;margin-top:2px&quot;&gt;按固定提交取 HGamey/experiments&lt;/div&gt;&lt;div style=&quot;font-family:PingFang SC;font-size:15px;line-height:1.38;color:#3A4A5E;margin-top:2px&quot;&gt;给脚本 PF_ROOT · PF_JOB_OUT 等环境&lt;/div&gt;&lt;div style=&quot;font-family:PingFang SC;font-size:15px;line-height:1.38;color:#3A4A5E;margin-top:2px&quot;&gt;产物留在节点 _jobs/&amp;lt;任务&amp;gt;&lt;/div&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#C9D3E0;strokeWidth=1.5;align=center;spacingLeft=8;spacingRight=8;" vertex="1" parent="1"><mxGeometry x="70" y="440" width="350" height="112" as="geometry"/></mxCell>
<mxCell id="c12" value="&lt;div style=&quot;font-family:PingFang SC;font-size:20px;font-weight:700;line-height:1.2;color:#0F2744&quot;&gt;设备采样 fleet&lt;/div&gt;&lt;div style=&quot;font-family:PingFang SC;font-size:15px;line-height:1.38;color:#3A4A5E;margin-top:2px&quot;&gt;空闲 30 s / 忙 60 s 一次&lt;/div&gt;&lt;div style=&quot;font-family:PingFang SC;font-size:15px;line-height:1.38;color:#3A4A5E;margin-top:2px&quot;&gt;电量 · 温度 · 风扇 · 前台应用 · 截图&lt;/div&gt;&lt;div style=&quot;font-family:PingFang SC;font-size:15px;line-height:1.38;color:#3A4A5E;margin-top:2px&quot;&gt;首页手机格的数据来源&lt;/div&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#C9D3E0;strokeWidth=1.5;align=center;spacingLeft=8;spacingRight=8;" vertex="1" parent="1"><mxGeometry x="445" y="440" width="350" height="112" as="geometry"/></mxCell>
<mxCell id="c13" value="&lt;div style=&quot;font-family:PingFang SC;font-size:20px;font-weight:700;line-height:1.2;color:#0F2744&quot;&gt;生命周期&lt;/div&gt;&lt;div style=&quot;font-family:PingFang SC;font-size:15px;line-height:1.38;color:#3A4A5E;margin-top:2px&quot;&gt;cancel：INT → TERM → KILL 整个进程组&lt;/div&gt;&lt;div style=&quot;font-family:PingFang SC;font-size:15px;line-height:1.38;color:#3A4A5E;margin-top:2px&quot;&gt;reset：一步停任务、放预留&lt;/div&gt;&lt;div style=&quot;font-family:PingFang SC;font-size:15px;line-height:1.38;color:#3A4A5E;margin-top:2px&quot;&gt;能恢复的地方不设防&lt;/div&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#C9D3E0;strokeWidth=1.5;align=center;spacingLeft=8;spacingRight=8;" vertex="1" parent="1"><mxGeometry x="820" y="440" width="340" height="112" as="geometry"/></mxCell>
<mxCell id="c14" value="&lt;div style=&quot;font-family:PingFang SC;font-size:20px;font-weight:700;line-height:1.2;color:#0F2744&quot;&gt;远程控制 remote&lt;/div&gt;&lt;div style=&quot;font-family:PingFang SC;font-size:15px;line-height:1.38;color:#3A4A5E;margin-top:2px&quot;&gt;人或 agent 远程操作某台手机&lt;/div&gt;&lt;div style=&quot;font-family:PingFang SC;font-size:15px;line-height:1.38;color:#3A4A5E;margin-top:2px&quot;&gt;请求排队，手机忙时返回 starting&lt;/div&gt;&lt;div style=&quot;font-family:PingFang SC;font-size:15px;line-height:1.38;color:#3A4A5E;margin-top:2px&quot;&gt;只由 phonefarm 的锁决定&lt;/div&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#C9D3E0;strokeWidth=1.5;align=center;spacingLeft=8;spacingRight=8;" vertex="1" parent="1"><mxGeometry x="1185" y="440" width="345" height="112" as="geometry"/></mxCell>
<mxCell id="c15" value="&lt;div style=&quot;font-family:PingFang SC;font-size:24px;font-weight:700;color:#1F6A47;text-align:left&quot;&gt;phonefarm · 设备层（Rust）&lt;span style=&quot;font-size:17px;font-weight:400;color:#1F6A47&quot;&gt;　phonefarm serve 由节点服务拉起&lt;/span&gt;&lt;/div&gt;" style="rounded=1;arcSize=3;whiteSpace=wrap;html=1;fillColor=#E8F3EE;strokeColor=#2E7D57;strokeWidth=2;verticalAlign=top;align=left;spacingLeft=18;spacingTop=8;" vertex="1" parent="1"><mxGeometry x="40" y="640" width="1520" height="250" as="geometry"/></mxCell>
<mxCell id="c16" value="&lt;div style=&quot;font-family:PingFang SC;font-size:20px;font-weight:700;line-height:1.2;color:#0F2744&quot;&gt;设备锁 devlock&lt;/div&gt;&lt;div style=&quot;font-family:PingFang SC;font-size:15px;line-height:1.38;color:#3A4A5E;margin-top:2px&quot;&gt;内核 fd 锁，两种范围：&lt;/div&gt;&lt;div style=&quot;font-family:PingFang SC;font-size:15px;line-height:1.38;color:#3A4A5E;margin-top:2px&quot;&gt;单台手机 / 全场&lt;/div&gt;&lt;div style=&quot;font-family:PingFang SC;font-size:15px;line-height:1.38;color:#3A4A5E;margin-top:2px&quot;&gt;持有进程退出即释放&lt;/div&gt;&lt;div style=&quot;font-family:PingFang SC;font-size:15px;line-height:1.38;color:#3A4A5E;margin-top:2px&quot;&gt;DEVLOCK_DIR 全机共用&lt;/div&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#C9D3E0;strokeWidth=1.5;align=center;spacingLeft=8;spacingRight=8;" vertex="1" parent="1"><mxGeometry x="70" y="695" width="280" height="165" as="geometry"/></mxCell>
<mxCell id="c17" value="&lt;div style=&quot;font-family:PingFang SC;font-size:20px;font-weight:700;line-height:1.2;color:#0F2744&quot;&gt;灰档层会话 gray-layer&lt;/div&gt;&lt;div style=&quot;font-family:PingFang SC;font-size:15px;line-height:1.38;color:#3A4A5E;margin-top:2px&quot;&gt;Vulkan 层 .so 挂进游戏&lt;/div&gt;&lt;div style=&quot;font-family:PingFang SC;font-size:15px;line-height:1.38;color:#3A4A5E;margin-top:2px&quot;&gt;（root：拷进应用 lib 目录）&lt;/div&gt;&lt;div style=&quot;font-family:PingFang SC;font-size:15px;line-height:1.38;color:#3A4A5E;margin-top:2px&quot;&gt;超分 · 插帧 · 子图层送显&lt;/div&gt;&lt;div style=&quot;font-family:PingFang SC;font-size:15px;line-height:1.38;color:#3A4A5E;margin-top:2px&quot;&gt;debug.knobs.* 控制&lt;/div&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#C9D3E0;strokeWidth=1.5;align=center;spacingLeft=8;spacingRight=8;" vertex="1" parent="1"><mxGeometry x="370" y="695" width="280" height="165" as="geometry"/></mxCell>
<mxCell id="c18" value="&lt;div style=&quot;font-family:PingFang SC;font-size:20px;font-weight:700;line-height:1.2;color:#0F2744&quot;&gt;测量&lt;/div&gt;&lt;div style=&quot;font-family:PingFang SC;font-size:15px;line-height:1.38;color:#3A4A5E;margin-top:2px&quot;&gt;SurfaceFlinger timestats / --latency&lt;/div&gt;&lt;div style=&quot;font-family:PingFang SC;font-size:15px;line-height:1.38;color:#3A4A5E;margin-top:2px&quot;&gt;ftrace（GPU 提交）&lt;/div&gt;&lt;div style=&quot;font-family:PingFang SC;font-size:15px;line-height:1.38;color:#3A4A5E;margin-top:2px&quot;&gt;停充功耗 · 截图锐度 · atrace&lt;/div&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#C9D3E0;strokeWidth=1.5;align=center;spacingLeft=8;spacingRight=8;" vertex="1" parent="1"><mxGeometry x="670" y="695" width="280" height="165" as="geometry"/></mxCell>
<mxCell id="c19" value="&lt;div style=&quot;font-family:PingFang SC;font-size:20px;font-weight:700;line-height:1.2;color:#0F2744&quot;&gt;进游戏与设备登记&lt;/div&gt;&lt;div style=&quot;font-family:PingFang SC;font-size:15px;line-height:1.38;color:#3A4A5E;margin-top:2px&quot;&gt;onboard：冷启动进大世界&lt;/div&gt;&lt;div style=&quot;font-family:PingFang SC;font-size:15px;line-height:1.38;color:#3A4A5E;margin-top:2px&quot;&gt;devices-set：稳定设备 ID&lt;/div&gt;&lt;div style=&quot;font-family:PingFang SC;font-size:15px;line-height:1.38;color:#3A4A5E;margin-top:2px&quot;&gt;+ USB / 无线别名&lt;/div&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#C9D3E0;strokeWidth=1.5;align=center;spacingLeft=8;spacingRight=8;" vertex="1" parent="1"><mxGeometry x="970" y="695" width="260" height="165" as="geometry"/></mxCell>
<mxCell id="c20" value="&lt;div style=&quot;font-family:PingFang SC;font-size:20px;font-weight:700;line-height:1.2;color:#0F2744&quot;&gt;可选：GOL / refbench&lt;/div&gt;&lt;div style=&quot;font-family:PingFang SC;font-size:15px;line-height:1.38;color:#3A4A5E;margin-top:2px&quot;&gt;game_opt_loop：自动优化循环&lt;/div&gt;&lt;div style=&quot;font-family:PingFang SC;font-size:15px;line-height:1.38;color:#3A4A5E;margin-top:2px&quot;&gt;（要大模型密钥，现为可选）&lt;/div&gt;&lt;div style=&quot;font-family:PingFang SC;font-size:15px;line-height:1.38;color:#3A4A5E;margin-top:2px&quot;&gt;refbench：白盒参考负载&lt;/div&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#C9D3E0;strokeWidth=1.5;dashed=1;dashPattern=6 4;align=center;spacingLeft=8;spacingRight=8;" vertex="1" parent="1"><mxGeometry x="1250" y="695" width="280" height="165" as="geometry"/></mxCell>
<mxCell id="c21" value="&lt;div style=&quot;font-family:PingFang SC;font-size:24px;font-weight:700;color:#8A4E22;text-align:left&quot;&gt;手机（全部插在生产节点 mbp1 上）&lt;/div&gt;" style="rounded=1;arcSize=3;whiteSpace=wrap;html=1;fillColor=#F7EEE4;strokeColor=#A0612F;strokeWidth=2;verticalAlign=top;align=left;spacingLeft=18;spacingTop=8;" vertex="1" parent="1"><mxGeometry x="40" y="950" width="1060" height="200" as="geometry"/></mxCell>
