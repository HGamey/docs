<mxCell id="c2" value="&lt;div style=&quot;font-family:PingFang SC;font-size:46px;font-weight:700;line-height:1.5;color:#0F2744&quot;&gt;部署拓扑：机器、手机、服务与 agent（2026-10-29）&lt;/div&gt;" style="text;html=1;whiteSpace=wrap;fillColor=none;strokeColor=none;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="40" y="16" width="1520" height="60" as="geometry"/></mxCell>
<mxCell id="c3" value="&lt;div style=&quot;font-family:PingFang SC;font-size:24px;font-weight:700;color:#1F6A47;text-align:left&quot;&gt;生产节点 mbp1 = macmini3&lt;span style=&quot;font-size:17px;font-weight:400;color:#1F6A47&quot;&gt;　Mac mini M4 · 16 GB · 192.168.3.91&lt;/span&gt;&lt;/div&gt;" style="rounded=1;arcSize=3;whiteSpace=wrap;html=1;fillColor=#E8F3EE;strokeColor=#2E7D57;strokeWidth=2;verticalAlign=top;align=left;spacingLeft=18;spacingTop=8;" vertex="1" parent="1"><mxGeometry x="40" y="100" width="760" height="690" as="geometry"/></mxCell>
<mxCell id="c4" value="&lt;div style=&quot;font-family:PingFang SC;font-size:20px;font-weight:700;line-height:1.2;color:#0F2744&quot;&gt;LaunchDaemon com.hgamey.node → ~/hgamey/run_node.sh&lt;/div&gt;&lt;div style=&quot;font-family:PingFang SC;font-size:15px;line-height:1.38;color:#3A4A5E;margin-top:2px&quot;&gt;node_service.py --port 8765（只听 127.0.0.1）&lt;/div&gt;&lt;div style=&quot;font-family:PingFang SC;font-size:15px;line-height:1.38;color:#3A4A5E;margin-top:2px&quot;&gt;└ 拉起 phonefarm serve；设 ANDROID_NDK_HOME、DEVLOCK_DIR=~/.local/state/phonefarm/locks&lt;/div&gt;&lt;div style=&quot;font-family:PingFang SC;font-size:15px;line-height:1.38;color:#3A4A5E;margin-top:2px&quot;&gt;日志 ~/hgamey/.state/node_service.log；KeepAlive，挂了自动拉起&lt;/div&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#C9D3E0;strokeWidth=1.5;align=left;spacingLeft=8;spacingRight=8;" vertex="1" parent="1"><mxGeometry x="70" y="160" width="700" height="128" as="geometry"/></mxCell>
<mxCell id="c5" value="&lt;div style=&quot;font-family:PingFang SC;font-size:20px;font-weight:700;line-height:1.2;color:#0F2744&quot;&gt;com.hgamey.tunnel&lt;/div&gt;&lt;div style=&quot;font-family:PingFang SC;font-size:15px;line-height:1.38;color:#3A4A5E;margin-top:2px&quot;&gt;cloudflared tunnel run mbp1&lt;/div&gt;&lt;div style=&quot;font-family:PingFang SC;font-size:15px;line-height:1.38;color:#3A4A5E;margin-top:2px&quot;&gt;~/.cloudflared/mbp1.yml&lt;/div&gt;&lt;div style=&quot;font-family:PingFang SC;font-size:15px;line-height:1.38;color:#3A4A5E;margin-top:2px&quot;&gt;mbp1.liyao.space → 127.0.0.1:8765&lt;/div&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#C9D3E0;strokeWidth=1.5;align=left;spacingLeft=8;spacingRight=8;" vertex="1" parent="1"><mxGeometry x="70" y="300" width="340" height="118" as="geometry"/></mxCell>
<mxCell id="c6" value="&lt;div style=&quot;font-family:PingFang SC;font-size:20px;font-weight:700;line-height:1.2;color:#0F2744&quot;&gt;部署检出与发布&lt;/div&gt;&lt;div style=&quot;font-family:PingFang SC;font-size:15px;line-height:1.38;color:#3A4A5E;margin-top:2px&quot;&gt;~/hgamey/src：HGamey/hgamey 的 git 检出&lt;/div&gt;&lt;div style=&quot;font-family:PingFang SC;font-size:15px;line-height:1.38;color:#3A4A5E;margin-top:2px&quot;&gt;deploy.py mbp1 → releases/&amp;lt;时间-提交&amp;gt;&lt;/div&gt;&lt;div style=&quot;font-family:PingFang SC;font-size:15px;line-height:1.38;color:#3A4A5E;margin-top:2px&quot;&gt;回执 deploy-receipts/ · 备份 .deploy/backups&lt;/div&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#C9D3E0;strokeWidth=1.5;align=left;spacingLeft=8;spacingRight=8;" vertex="1" parent="1"><mxGeometry x="430" y="300" width="340" height="118" as="geometry"/></mxCell>
<mxCell id="c7" value="&lt;div style=&quot;font-family:PingFang SC;font-size:20px;font-weight:700;line-height:1.2;color:#0F2744&quot;&gt;数据（部署不碰）&lt;/div&gt;&lt;div style=&quot;font-family:PingFang SC;font-size:15px;line-height:1.38;color:#3A4A5E;margin-top:2px&quot;&gt;phonefarm/_jobs：任务产物&lt;/div&gt;&lt;div style=&quot;font-family:PingFang SC;font-size:15px;line-height:1.38;color:#3A4A5E;margin-top:2px&quot;&gt;研究库 · 设备登记 · 锁目录&lt;/div&gt;&lt;div style=&quot;font-family:PingFang SC;font-size:15px;line-height:1.38;color:#3A4A5E;margin-top:2px&quot;&gt;.state/node.token（管理 token）&lt;/div&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#C9D3E0;strokeWidth=1.5;align=left;spacingLeft=8;spacingRight=8;" vertex="1" parent="1"><mxGeometry x="70" y="430" width="340" height="118" as="geometry"/></mxCell>
<mxCell id="c8" value="&lt;div style=&quot;font-family:PingFang SC;font-size:20px;font-weight:700;line-height:1.2;color:#0F2744&quot;&gt;工具链&lt;/div&gt;&lt;div style=&quot;font-family:PingFang SC;font-size:15px;line-height:1.38;color:#3A4A5E;margin-top:2px&quot;&gt;adb（homebrew）· hdc（tools/ohos-sdk）&lt;/div&gt;&lt;div style=&quot;font-family:PingFang SC;font-size:15px;line-height:1.38;color:#3A4A5E;margin-top:2px&quot;&gt;NDK r28c（tools/ndk）· Rust · Python 3.14&lt;/div&gt;&lt;div style=&quot;font-family:PingFang SC;font-size:15px;line-height:1.38;color:#3A4A5E;margin-top:2px&quot;&gt;~/.config/hgamey：dash.pass / steer.pass&lt;/div&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#C9D3E0;strokeWidth=1.5;align=left;spacingLeft=8;spacingRight=8;" vertex="1" parent="1"><mxGeometry x="430" y="430" width="340" height="118" as="geometry"/></mxCell>
<mxCell id="c9" value="&lt;div style=&quot;font-family:PingFang SC;font-size:15px;font-weight:700;line-height:1.2;color:#0F2744&quot;&gt;手机都用 USB 直连 macmini3，各占一个 USB 控制器。远程登录走 frpc（SSH / VNC）。同机还有与 HGamey 无关的服务（家庭自动化、本地模型、其他项目），不要动&lt;/div&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#EFF3F8;strokeColor=#9AA8BA;strokeWidth=1.5;align=center;spacingLeft=8;spacingRight=8;" vertex="1" parent="1"><mxGeometry x="70" y="560" width="700" height="70" as="geometry"/></mxCell>
<mxCell id="c10" value="&lt;div style=&quot;font-family:PingFang SC;font-size:20px;font-weight:700;line-height:1.2;color:#8A4E22&quot;&gt;红魔 11 Pro+&lt;/div&gt;&lt;div style=&quot;font-family:PingFang SC;font-size:15px;line-height:1.38;color:#3A4A5E;margin-top:2px&quot;&gt;NX809J · 91253241019A&lt;/div&gt;&lt;div style=&quot;font-family:PingFang SC;font-size:15px;line-height:1.38;color:#3A4A5E;margin-top:2px&quot;&gt;adb · root&lt;/div&gt;&lt;div style=&quot;font-family:PingFang SC;font-size:15px;line-height:1.38;color:#3A4A5E;margin-top:2px&quot;&gt;独占一个 USB 控制器&lt;/div&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#F7EEE4;strokeColor=#A0612F;strokeWidth=1.5;align=center;spacingLeft=8;spacingRight=8;" vertex="1" parent="1"><mxGeometry x="70" y="650" width="225" height="120" as="geometry"/></mxCell>
<mxCell id="c11" value="&lt;div style=&quot;font-family:PingFang SC;font-size:20px;font-weight:700;line-height:1.2;color:#8A4E22&quot;&gt;荣耀 AAP-AN00&lt;/div&gt;&lt;div style=&quot;font-family:PingFang SC;font-size:15px;line-height:1.38;color:#3A4A5E;margin-top:2px&quot;&gt;AVXB6R5C19000481&lt;/div&gt;&lt;div style=&quot;font-family:PingFang SC;font-size:15px;line-height:1.38;color:#3A4A5E;margin-top:2px&quot;&gt;adb · 未 root&lt;/div&gt;&lt;div style=&quot;font-family:PingFang SC;font-size:15px;line-height:1.38;color:#3A4A5E;margin-top:2px&quot;&gt;独占一个 USB 控制器&lt;/div&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#F7EEE4;strokeColor=#A0612F;strokeWidth=1.5;align=center;spacingLeft=8;spacingRight=8;" vertex="1" parent="1"><mxGeometry x="310" y="650" width="225" height="120" as="geometry"/></mxCell>
<mxCell id="c12" value="&lt;div style=&quot;font-family:PingFang SC;font-size:20px;font-weight:700;line-height:1.2;color:#8A4E22&quot;&gt;华为 EMA-AL00U&lt;/div&gt;&lt;div style=&quot;font-family:PingFang SC;font-size:15px;line-height:1.38;color:#3A4A5E;margin-top:2px&quot;&gt;hdc:88X9K26901026869&lt;/div&gt;&lt;div style=&quot;font-family:PingFang SC;font-size:15px;line-height:1.38;color:#3A4A5E;margin-top:2px&quot;&gt;HarmonyOS · hdc&lt;/div&gt;&lt;div style=&quot;font-family:PingFang SC;font-size:15px;line-height:1.38;color:#3A4A5E;margin-top:2px&quot;&gt;独占一个 USB 控制器&lt;/div&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#F7EEE4;strokeColor=#A0612F;strokeWidth=1.5;align=center;spacingLeft=8;spacingRight=8;" vertex="1" parent="1"><mxGeometry x="550" y="650" width="220" height="120" as="geometry"/></mxCell>
<mxCell id="c13" value="&lt;div style=&quot;font-family:PingFang SC;font-size:24px;font-weight:700;color:#1D4FA8;text-align:left&quot;&gt;rhodes1：同事的 Linux 工作机&lt;span style=&quot;font-size:17px;font-weight:400;color:#1D4FA8&quot;&gt;　测试节点 · agent 会话 · 调度&lt;/span&gt;&lt;/div&gt;" style="rounded=1;arcSize=3;whiteSpace=wrap;html=1;fillColor=#EAF1FB;strokeColor=#2D63C8;strokeWidth=2;verticalAlign=top;align=left;spacingLeft=18;spacingTop=8;" vertex="1" parent="1"><mxGeometry x="840" y="100" width="720" height="690" as="geometry"/></mxCell>
<mxCell id="c14" value="&lt;div style=&quot;font-family:PingFang SC;font-size:17px;font-weight:700;line-height:1.2;color:#0F2744&quot;&gt;systemd --user：hgamey-hub.service（:8765）+ hgamey-node-b.service（:8766）&lt;/div&gt;&lt;div style=&quot;font-family:PingFang SC;font-size:15px;line-height:1.38;color:#3A4A5E;margin-top:2px&quot;&gt;两个测试节点实例，部署顺序 main → rhodes1 → mbp1&lt;/div&gt;&lt;div style=&quot;font-family:PingFang SC;font-size:15px;line-height:1.38;color:#3A4A5E;margin-top:2px&quot;&gt;展示页 /dash/showcase、/dash/showcase/command（读 mbp1 的只读导出）&lt;/div&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#C9D3E0;strokeWidth=1.5;align=left;spacingLeft=8;spacingRight=8;" vertex="1" parent="1"><mxGeometry x="870" y="160" width="660" height="100" as="geometry"/></mxCell>
<mxCell id="c15" value="&lt;div style=&quot;font-family:PingFang SC;font-size:20px;font-weight:700;line-height:1.2;color:#0F2744&quot;&gt;team-loop（cron 每 5 分钟）&lt;/div&gt;&lt;div style=&quot;font-family:PingFang SC;font-size:15px;line-height:1.38;color:#3A4A5E;margin-top:2px&quot;&gt;/HGamey-dev/HGamey/team-loop/&lt;/div&gt;&lt;div style=&quot;font-family:PingFang SC;font-size:15px;line-height:1.38;color:#3A4A5E;margin-top:2px&quot;&gt;空闲满 30 分钟就唤醒 agent&lt;/div&gt;&lt;div style=&quot;font-family:PingFang SC;font-size:15px;line-height:1.38;color:#3A4A5E;margin-top:2px&quot;&gt;建 STOP 文件全部暂停&lt;/div&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#C9D3E0;strokeWidth=1.5;align=left;spacingLeft=8;spacingRight=8;" vertex="1" parent="1"><mxGeometry x="870" y="272" width="320" height="120" as="geometry"/></mxCell>
<mxCell id="c16" value="&lt;div style=&quot;font-family:PingFang SC;font-size:20px;font-weight:700;line-height:1.2;color:#0F2744&quot;&gt;到 mbp1 的通道&lt;/div&gt;&lt;div style=&quot;font-family:PingFang SC;font-size:15px;line-height:1.38;color:#3A4A5E;margin-top:2px&quot;&gt;SSH 隧道 hgamey-mbp1-tunnel&lt;/div&gt;&lt;div style=&quot;font-family:PingFang SC;font-size:15px;line-height:1.38;color:#3A4A5E;margin-top:2px&quot;&gt;127.0.0.1:18765 → mbp1:8765&lt;/div&gt;&lt;div style=&quot;font-family:PingFang SC;font-size:15px;line-height:1.38;color:#3A4A5E;margin-top:2px&quot;&gt;agent CLI 固定为 mbp1 的提交&lt;/div&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#C9D3E0;strokeWidth=1.5;align=left;spacingLeft=8;spacingRight=8;" vertex="1" parent="1"><mxGeometry x="1210" y="272" width="320" height="120" as="geometry"/></mxCell>
<mxCell id="c17" value="&lt;div style=&quot;font-family:PingFang SC;font-size:20px;font-weight:700;line-height:1.2;color:#0F2744&quot;&gt;&lt;/div&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#C9D3E0;strokeWidth=1.5;align=center;spacingLeft=8;spacingRight=8;" vertex="1" parent="1"><mxGeometry x="870" y="404" width="660" height="236" as="geometry"/></mxCell>
<mxCell id="c18" value="&lt;div style=&quot;font-family:PingFang SC;font-size:17px;font-weight:700;line-height:1.5;color:#1D4FA8&quot;&gt;平台上的 agent（各有 token，在 /dash/ 首页可见）&lt;/div&gt;" style="text;html=1;whiteSpace=wrap;fillColor=none;strokeColor=none;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="890" y="410" width="620" height="30" as="geometry"/></mxCell>
<mxCell id="c19" value="&lt;div style=&quot;font-family:PingFang SC;font-size:15px;font-weight:400;line-height:1.5;color:#0F2744&quot;&gt;claude-lead　首席开发者（Claude），基线、节奏、生产运维&lt;/div&gt;&lt;div style=&quot;font-family:PingFang SC;font-size:15px;font-weight:400;line-height:1.5;color:#0F2744&quot;&gt;glm-ops　部署（只上 main 最新提交）、重置卡住的任务、扮演人做验收&lt;/div&gt;&lt;div style=&quot;font-family:PingFang SC;font-size:15px;font-weight:400;line-height:1.5;color:#0F2744&quot;&gt;glm-researcher　外部研究员：原神超分 / 插帧（红魔），华为复现&lt;/div&gt;&lt;div style=&quot;font-family:PingFang SC;font-size:15px;font-weight:400;line-height:1.5;color:#0F2744&quot;&gt;kimi-researcher　外部研究员：只靠 CLI 上手（荣耀），红魔复现&lt;/div&gt;" style="text;html=1;whiteSpace=wrap;fillColor=none;strokeColor=none;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="890" y="440" width="620" height="96" as="geometry"/></mxCell>
<mxCell id="c20" value="&lt;div style=&quot;font-family:PingFang SC;font-size:17px;font-weight:700;line-height:1.5;color:#1D4FA8&quot;&gt;开发 agent（不在平台注册，直接改代码推 main）&lt;/div&gt;" style="text;html=1;whiteSpace=wrap;fillColor=none;strokeColor=none;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="890" y="534" width="620" height="26" as="geometry"/></mxCell>
<mxCell id="c21" value="&lt;div style=&quot;font-family:PingFang SC;font-size:15px;font-weight:400;line-height:1.5;color:#0F2744&quot;&gt;HGamey-Claude-Sub　前端美观（HAPI 会话）&lt;/div&gt;&lt;div style=&quot;font-family:PingFang SC;font-size:15px;font-weight:400;line-height:1.5;color:#0F2744&quot;&gt;HGamey-Codex-Sub　复杂后端，GPT-6-Astra（HAPI 会话）&lt;/div&gt;&lt;div style=&quot;font-family:PingFang SC;font-size:15px;font-weight:400;line-height:1.5;color:#0F2744&quot;&gt;kimi-web 前端功能（空闲）· kimi-simplify 定期审查 Codex 提交&lt;/div&gt;" style="text;html=1;whiteSpace=wrap;fillColor=none;strokeColor=none;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="890" y="560" width="620" height="76" as="geometry"/></mxCell>
<mxCell id="c22" value="&lt;div style=&quot;font-family:PingFang SC;font-size:17px;font-weight:700;line-height:1.2;color:#0F2744&quot;&gt;给人的消息：meiso-board（kamico.closure.moe）&lt;/div&gt;&lt;div style=&quot;font-family:PingFang SC;font-size:15px;line-height:1.38;color:#3A4A5E;margin-top:2px&quot;&gt;身份 HGamey-lead，只由首席发：每天 ≤ 5 条留言、同时 ≤ 3 张「过目 / 动手」卡&lt;/div&gt;&lt;div style=&quot;font-family:PingFang SC;font-size:15px;line-height:1.38;color:#3A4A5E;margin-top:2px&quot;&gt;用户点了卡会叫醒首席的会话&lt;/div&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#C9D3E0;strokeWidth=1.5;align=left;spacingLeft=8;spacingRight=8;" vertex="1" parent="1"><mxGeometry x="870" y="652" width="660" height="118" as="geometry"/></mxCell>
<mxCell id="c23" value="&lt;div style=&quot;font-family:PingFang SC;font-size:24px;font-weight:700;color:#8F6210;text-align:left&quot;&gt;云与外部服务&lt;/div&gt;" style="rounded=1;arcSize=3;whiteSpace=wrap;html=1;fillColor=#FDF3E1;strokeColor=#C48A1C;strokeWidth=2;verticalAlign=top;align=left;spacingLeft=18;spacingTop=8;" vertex="1" parent="1"><mxGeometry x="40" y="830" width="1520" height="250" as="geometry"/></mxCell>
<mxCell id="c24" value="&lt;div style=&quot;font-family:PingFang SC;font-size:20px;font-weight:700;line-height:1.2;color:#0F2744&quot;&gt;Cloudflare&lt;/div&gt;&lt;div style=&quot;font-family:PingFang SC;font-size:15px;line-height:1.38;color:#3A4A5E;margin-top:2px&quot;&gt;隧道 mbp1&lt;/div&gt;&lt;div style=&quot;font-family:PingFang SC;font-size:15px;line-height:1.38;color:#3A4A5E;margin-top:2px&quot;&gt;→ https://mbp1.liyao.space&lt;/div&gt;&lt;div style=&quot;font-family:PingFang SC;font-size:15px;line-height:1.38;color:#3A4A5E;margin-top:2px&quot;&gt;人和网页截图走这里&lt;/div&gt;&lt;div style=&quot;font-family:PingFang SC;font-size:15px;line-height:1.38;color:#3A4A5E;margin-top:2px&quot;&gt;公网偶有 502，&lt;/div&gt;&lt;div style=&quot;font-family:PingFang SC;font-size:15px;line-height:1.38;color:#3A4A5E;margin-top:2px&quot;&gt;agent 改走 SSH 隧道&lt;/div&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#C9D3E0;strokeWidth=1.5;align=center;spacingLeft=8;spacingRight=8;" vertex="1" parent="1"><mxGeometry x="70" y="885" width="280" height="170" as="geometry"/></mxCell>
<mxCell id="c25" value="&lt;div style=&quot;font-family:PingFang SC;font-size:20px;font-weight:700;line-height:1.2;color:#0F2744&quot;&gt;GitHub · HGamey 组织&lt;/div&gt;&lt;div style=&quot;font-family:PingFang SC;font-size:15px;line-height:1.38;color:#3A4A5E;margin-top:2px&quot;&gt;hgamey：代码 + 两项 CI&lt;/div&gt;&lt;div style=&quot;font-family:PingFang SC;font-size:15px;line-height:1.38;color:#3A4A5E;margin-top:2px&quot;&gt;experiments：实验脚本&lt;/div&gt;&lt;div style=&quot;font-family:PingFang SC;font-size:15px;line-height:1.38;color:#3A4A5E;margin-top:2px&quot;&gt;（任务按提交号运行）&lt;/div&gt;&lt;div style=&quot;font-family:PingFang SC;font-size:15px;line-height:1.38;color:#3A4A5E;margin-top:2px&quot;&gt;docs：报告、计划、图&lt;/div&gt;&lt;div style=&quot;font-family:PingFang SC;font-size:15px;line-height:1.38;color:#3A4A5E;margin-top:2px&quot;&gt;旧仓库已归档只读&lt;/div&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#C9D3E0;strokeWidth=1.5;align=center;spacingLeft=8;spacingRight=8;" vertex="1" parent="1"><mxGeometry x="370" y="885" width="290" height="170" as="geometry"/></mxCell>
<mxCell id="c26" value="&lt;div style=&quot;font-family:PingFang SC;font-size:20px;font-weight:700;line-height:1.2;color:#0F2744&quot;&gt;大模型中转 api-relay&lt;/div&gt;&lt;div style=&quot;font-family:PingFang SC;font-size:15px;line-height:1.38;color:#3A4A5E;margin-top:2px&quot;&gt;relay/zhipu/glm-5.3（GLM agent）&lt;/div&gt;&lt;div style=&quot;font-family:PingFang SC;font-size:15px;line-height:1.38;color:#3A4A5E;margin-top:2px&quot;&gt;relay/kimi/k3.1-pro（Kimi agent）&lt;/div&gt;&lt;div style=&quot;font-family:PingFang SC;font-size:15px;line-height:1.38;color:#3A4A5E;margin-top:2px&quot;&gt;限流时 GLM 会话临时换 Kimi&lt;/div&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#C9D3E0;strokeWidth=1.5;align=center;spacingLeft=8;spacingRight=8;" vertex="1" parent="1"><mxGeometry x="680" y="885" width="280" height="170" as="geometry"/></mxCell>
<mxCell id="c27" value="&lt;div style=&quot;font-family:PingFang SC;font-size:20px;font-weight:700;line-height:1.2;color:#0F2744&quot;&gt;Vercel&lt;/div&gt;&lt;div style=&quot;font-family:PingFang SC;font-size:15px;line-height:1.38;color:#3A4A5E;margin-top:2px&quot;&gt;selfsr 对外报告页&lt;/div&gt;&lt;div style=&quot;font-family:PingFang SC;font-size:15px;line-height:1.38;color:#3A4A5E;margin-top:2px&quot;&gt;hgamey-selfsr-report.vercel.app&lt;/div&gt;&lt;div style=&quot;font-family:PingFang SC;font-size:15px;line-height:1.38;color:#3A4A5E;margin-top:2px&quot;&gt;从 docs 的 site/ 手动部署&lt;/div&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#C9D3E0;strokeWidth=1.5;align=center;spacingLeft=8;spacingRight=8;" vertex="1" parent="1"><mxGeometry x="980" y="885" width="260" height="170" as="geometry"/></mxCell>
<mxCell id="c28" value="&lt;div style=&quot;font-family:PingFang SC;font-size:20px;font-weight:700;line-height:1.2;color:#0F2744&quot;&gt;BH3GEI 的 MacBook&lt;/div&gt;&lt;div style=&quot;font-family:PingFang SC;font-size:15px;line-height:1.38;color:#3A4A5E;margin-top:2px&quot;&gt;selfsr 研究（手动）· 文档 · 报告页&lt;/div&gt;&lt;div style=&quot;font-family:PingFang SC;font-size:15px;line-height:1.38;color:#3A4A5E;margin-top:2px&quot;&gt;不跑节点服务，不插手机&lt;/div&gt;&lt;div style=&quot;font-family:PingFang SC;font-size:15px;line-height:1.38;color:#3A4A5E;margin-top:2px&quot;&gt;局域网 ssh 到 macmini3&lt;/div&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#C9D3E0;strokeWidth=1.5;align=center;spacingLeft=8;spacingRight=8;" vertex="1" parent="1"><mxGeometry x="1260" y="885" width="270" height="170" as="geometry"/></mxCell>
<mxCell id="c29" value="&lt;div style=&quot;font-family:PingFang SC;font-size:20px;font-weight:700;line-height:1.2;color:#0F2744&quot;&gt;人&lt;/div&gt;&lt;div style=&quot;font-family:PingFang SC;font-size:15px;line-height:1.38;color:#3A4A5E;margin-top:2px&quot;&gt;浏览器打开 https://mbp1.liyao.space/dash/ ：查看口令看，写操作口令建任务 / 指派 / 给指导&lt;/div&gt;&lt;div style=&quot;font-family:PingFang SC;font-size:15px;line-height:1.38;color:#3A4A5E;margin-top:2px&quot;&gt;看板消息在 meiso-board；对外报告在 Vercel 页面&lt;/div&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#EFF3F8;strokeColor=#9AA8BA;strokeWidth=1.5;align=left;spacingLeft=8;spacingRight=8;" vertex="1" parent="1"><mxGeometry x="40" y="1110" width="760" height="110" as="geometry"/></mxCell>
